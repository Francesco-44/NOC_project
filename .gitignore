# Colcon artifacts
/build/
/install/
/log/
/bags_recordings/

# Python caches
__pycache__/
*.py[cod]

# Tooling caches
.pytest_cache/
.mypy_cache/

# Editor / OS
.vscode/
.DS_Store

# Tuning artifacts
tuning_results/**/rosbag/
*.db3

# Large source videos kept locally only (GIF preview is committed instead)
assets/*.mp4

# Figure e metriche generate dagli strumenti di visualizzazione: sono
# versionate, cosi' i risultati sono consultabili direttamente dal repo.
# Restano fuori solo le GIF, troppo pesanti (~7 MB l'una) e rigenerabili.
viz/out/**/*.gif
viz/bags/

# Albero di compilazione del report: di norma si versiona solo il sorgente.
# Metrics/ resta escluso perche' rigenerato da make_results; Images/ e il PDF
# compilato sono eccezioni deliberate, cosi' il report si legge dal repo senza
# doverlo ricompilare.
/report_draft/build_integrated/*
!/report_draft/build_integrated/Report_integrated.tex
# Istantanea congelata del sorgente, tenuta di proposito accanto all'originale:
# senza questa riga la regola qui sopra la ingoierebbe e il backup non sarebbe
# versionato ne' presente in un clone nuovo -- un backup che non c'e'.
!/report_draft/build_integrated/Report_integrated_backup.tex
!/report_draft/build_integrated/Images/
!/report_draft/build_integrated/Report_integrated.pdf
# Versione di Relo02 (commit dd93b8e, 2026-09-03): primi due capitoli riscritti
# ma su una base precedente al passaggio alla sola piattaforma G1, quindi con Go2
# e CHAMP ancora dentro. Tenuta accanto all'originale perche' quei due capitoli
# vanno riconciliati e il diff serve; senza queste due righe la regola generale
# la ingoierebbe.
!/report_draft/build_integrated/Report_integrated_Lori.tex
!/report_draft/build_integrated/Report_integrated_Lori.pdf
